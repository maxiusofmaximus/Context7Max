# ── Supabase ─────────────────────────────────────────────
SUPABASE_URL=https://<project-ref>.supabase.co
# Service role key: SOLO servidor/CLI. Nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=
# Anon key (dashboard público, lectura limitada)
SUPABASE_ANON_KEY=

# ── API pública (Vercel) ─────────────────────────────────
# Clave maestra para consumir la API (Authorization: Bearer ...)
# Formato sugerido: ctx7mk-<random>
CTX7MAX_API_KEY=

# Secreto para autorizar la ingesta via POST /api/v2/add/* y /api/v1/refresh
CTX7MAX_ADMIN_KEY=

# URL pública desplegada (para el CLI y el MCP)
CTX7MAX_API_URL=http://localhost:3000

# ── GitHub (opcional, más rate limit en ingesta) ─────────
GITHUB_TOKEN=

# ── Embeddings ───────────────────────────────────────────
# Proveedor por defecto: edge (Supabase Edge Function gte-small, gratis)
# Valores: edge | local | none
EMBEDDINGS_PROVIDER=edge
